@echo off
chcp 65001 > nul
title Отправка проекта на GitHub

echo ======================================================================
echo           🚀 Отправка GeoRadar CRM на GitHub (osposmak)
echo ======================================================================
echo.
echo Отправляем ветку main в https://github.com/osposmak/GeoRadar.git ...
echo.

git push -u origin main

if errorlevel 1 (
    echo.
    echo ======================================================================
    echo [!] ОШИБКА АВТОРИЗАЦИИ В GITHUB
    echo.
    echo Причина: В Windows сохранён вход под другим аккаунтом (например MaiRYoUTuBe).
    echo.
    echo КАК ИСПРАВИТЬ ЗА 30 СЕКУНД:
    echo 1. Откройте Пуск -> введите "Диспетчер учетных данных" (Credential Manager)
    echo 2. Выберите "Учетные данные Windows"
    echo 3. В списке найдите "git:https://github.com" и нажмите "Удалить"
    echo 4. Запустите этот файл push_to_github.bat снова
    echo 5. В открывшемся окне браузера войдите под вашим аккаунтом osposmak!
    echo ======================================================================
) else (
    echo.
    echo ======================================================================
    echo [OK] УСПЕШНО! Все файлы загружены в https://github.com/osposmak/GeoRadar
    echo ======================================================================
)

echo.
pause
